          <div className="divide-y divide-border">
            {overview.customerSignals.map((signal) => (
              <Link
                key={signal.id}
                href={signal.href}
                className="flex items-center justify-between gap-4 px-5 py-3.5 transition-colors hover:bg-surface-subtle/70"
