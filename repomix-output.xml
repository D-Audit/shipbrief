<file path="src/components/marketing/animated-rainbow-ribbon.tsx">
"use client";

import { useEffect, useRef } from "react";

type RibbonColors = {
  yellow?: string;
  orange?: string;
  pink?: string;
  purple?: string;
  blue?: string;
};

type AnimatedRainbowRibbonProps = {
  speed?: number;
  opacity?: number;
  blur?: number;
  scale?: number;
  colors?: RibbonColors;
  mouseStrength?: number;
  className?: string;
};

/**
 * A configurable, code-drawn hero backdrop made from layered SVG ribbons.
 * It is intentionally marketing-only; product screens remain visually calm.
 */
export function AnimatedRainbowRibbon({
  speed = 1,
  opacity = 0.92,
  blur = 0,
  scale = 1,
  colors = {},
  mouseStrength = 10,
  className,
}: AnimatedRainbowRibbonProps) {
  const elementRef = useRef<HTMLDivElement>(null);

  useEffect(() => {
    const reducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)");
    if (reducedMotion.matches || mouseStrength === 0) return;

    let animationFrame = 0;
    let pointerX = 0;
    let pointerY = 0;

    const update = () => {
      animationFrame = 0;
      const node = elementRef.current;
      if (!node) return;
      node.style.setProperty("--arr-pointer-x", `${pointerX * mouseStrength}px`);
      node.style.setProperty("--arr-pointer-y", `${pointerY * mouseStrength}px`);
    };

    const onPointerMove = (event: PointerEvent) => {
      pointerX = event.clientX / window.innerWidth - 0.5;
      pointerY = event.clientY / window.innerHeight - 0.5;
      if (!animationFrame) animationFrame = window.requestAnimationFrame(update);
    };

    window.addEventListener("pointermove", onPointerMove, { passive: true });
    return () => {
      window.removeEventListener("pointermove", onPointerMove);
      if (animationFrame) window.cancelAnimationFrame(animationFrame);
    };
  }, [mouseStrength]);

  const style = {
    "--arr-speed": `${speed}`,
    "--arr-opacity": `${opacity}`,
    "--arr-blur": `${blur}px`,
    "--arr-scale": `${scale}`,
    "--arr-yellow": colors.yellow ?? "#ffdb6f",
    "--arr-orange": colors.orange ?? "#ff925b",
    "--arr-pink": colors.pink ?? "#ed57aa",
    "--arr-purple": colors.purple ?? "#7c6ee8",
    "--arr-blue": colors.blue ?? "#89c8f7",
  } as React.CSSProperties;

  return (
    <div ref={elementRef} aria-hidden="true" style={style} className={`sb-animated-rainbow-ribbon ${className ?? ""}`}>
      <svg viewBox="0 0 1600 900" preserveAspectRatio="none" className="size-full" focusable="false">
        <defs>
          <linearGradient id="shipbrief-ribbon-main" x1="760" y1="0" x2="1520" y2="760" gradientUnits="userSpaceOnUse">
            <stop stopColor="var(--arr-blue)" /><stop offset="0.24" stopColor="var(--arr-purple)" /><stop offset="0.52" stopColor="var(--arr-pink)" /><stop offset="0.77" stopColor="var(--arr-orange)" /><stop offset="1" stopColor="var(--arr-yellow)" />
          </linearGradient>
          <linearGradient id="shipbrief-ribbon-inner" x1="780" y1="0" x2="1480" y2="690" gradientUnits="userSpaceOnUse">
            <stop stopColor="var(--arr-purple)" /><stop offset="0.38" stopColor="var(--arr-pink)" /><stop offset="0.7" stopColor="var(--arr-orange)" /><stop offset="1" stopColor="var(--arr-yellow)" />
          </linearGradient>
          <linearGradient id="shipbrief-ribbon-sweep" x1="660" y1="100" x2="1520" y2="620" gradientUnits="userSpaceOnUse">
            <stop stopColor="var(--arr-blue)" /><stop offset="0.36" stopColor="var(--arr-purple)" /><stop offset="0.68" stopColor="var(--arr-pink)" /><stop offset="1" stopColor="var(--arr-orange)" />
          </linearGradient>
          <filter id="shipbrief-ribbon-glow" x="-30%" y="-30%" width="160%" height="160%"><feGaussianBlur stdDeviation="32" /></filter>
        </defs>
        <g className="sb-ribbon-glow" filter="url(#shipbrief-ribbon-glow)">
          <ellipse cx="1300" cy="210" rx="300" ry="205" fill="var(--arr-orange)" opacity=".36" />
          <ellipse cx="1440" cy="630" rx="250" ry="280" fill="var(--arr-pink)" opacity=".26" />
        </g>
        <g className="sb-ribbon-layer sb-ribbon-layer-back">
          <path fill="url(#shipbrief-ribbon-sweep)" opacity=".17" d="M-180 -40 C106 66 265 164 523 105 C794 43 937 101 1116 223 C1303 350 1271 521 1640 632 L1640 875 C1188 720 1151 494 1003 369 C851 239 721 349 503 201 C250 29 31 91 -180 103 Z" />
        </g>
        <g className="sb-ribbon-layer sb-ribbon-layer-main">
          <path fill="url(#shipbrief-ribbon-main)" d="M820 -105 C1023 34 1127 111 1275 257 C1436 416 1418 635 1640 870 L1459 962 C1224 696 1264 492 1115 338 C984 201 868 125 667 -47 Z" />
        </g>
        <g className="sb-ribbon-layer sb-ribbon-layer-front">
          <path fill="url(#shipbrief-ribbon-inner)" opacity=".76" d="M1023 -84 C1146 89 1267 166 1361 315 C1462 477 1424 646 1580 929 L1413 950 C1275 697 1305 512 1218 374 C1136 245 1014 164 868 -50 Z" />
          <path fill="url(#shipbrief-ribbon-sweep)" opacity=".4" d="M684 18 C845 137 985 150 1091 272 C1205 404 1242 498 1496 611 L1496 707 C1190 614 1138 504 1024 377 C904 243 781 266 618 137 Z" />
        </g>
      </svg>
    </div>
  );
}
