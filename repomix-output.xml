      </div>

      <section className="sb-panel overflow-hidden">
        <div className="flex items-center justify-between border-b border-border px-5 py-4"><div><Typography variant="section-title">Recent activity</Typography><p className="mt-1 text-xs text-muted-foreground">Signals from your team and connected tools.</p></div><Link href="/app/activity" className="text-xs font-medium text-primary hover:underline">View all</Link></div>
        <div className="divide-y divide-border">
          {activity.map((event) => <Link key={event.id} href={event.link ?? "/app/activity"} className="flex items-center gap-3 px-5 py-3 text-sm transition-colors hover:bg-surface-subtle/70"><span className="size-1.5 shrink-0 rounded-full bg-primary" /><span className="flex-1">{event.message}</span><span className="text-xs text-muted-foreground">{new Date(event.timestamp).toLocaleDateString(undefined, { month: "short", day: "numeric" })}</span></Link>)}
        </div>
      </section>
    </div>
  );
}
