  --sb-surface: #ffffff;
  --sb-surface-subtle: #f1f1f3;
  --sb-foreground: #171717;
  --sb-muted: #68696e;
  --sb-border: #e0e0e4;
  --sb-border-strong: #cfd0d5;
  --sb-primary: #c85069;
  --sb-primary-hover: #aa3f56;
  --sb-primary-muted: #f7e2e7;
  --sb-success: #16a34a;
  --sb-success-muted: #ecfdf3;
  --sb-warning: #d97706;
  --sb-warning-muted: #fffbeb;
  --sb-danger: #dc2626;
  --sb-danger-muted: #fef2f2;

  /* shadcn semantic mapping */
  --background: var(--sb-background);
  --foreground: var(--sb-foreground);
  --surface: var(--sb-surface);
  --surface-subtle: var(--sb-surface-subtle);
  --card: var(--sb-surface);
  --card-foreground: var(--sb-foreground);
  --popover: var(--sb-surface);
  --popover-foreground: var(--sb-foreground);
  --primary: var(--sb-primary);
  --primary-foreground: #ffffff;
  --secondary: var(--sb-surface-subtle);
  --secondary-foreground: var(--sb-foreground);
  --muted: var(--sb-surface-subtle);
  --muted-foreground: var(--sb-muted);
  --accent: var(--sb-primary-muted);
  --accent-foreground: var(--sb-primary);
  --destructive: var(--sb-danger);
  --success: var(--sb-success);
  --success-muted: var(--sb-success-muted);
  --warning: var(--sb-warning);
  --warning-muted: var(--sb-warning-muted);
  --danger: var(--sb-danger);
  --danger-muted: var(--sb-danger-muted);
  --border: var(--sb-border);
  --input: var(--sb-border);
  --ring: color-mix(in oklab, var(--sb-primary) 35%, transparent);
  --radius: 0.4375rem;
  --chart-1: var(--sb-primary);
  --chart-2: #d9768c;
  --chart-3: #e6a5b3;
  --chart-4: #f2cdd5;
  --chart-5: #fae8eb;
  --sidebar: var(--sb-surface);
  --sidebar-foreground: var(--sb-foreground);
  --sidebar-primary: var(--sb-primary);
  --sidebar-primary-foreground: #ffffff;
  --sidebar-accent: var(--sb-surface-subtle);
  --sidebar-accent-foreground: var(--sb-foreground);
  --sidebar-border: var(--sb-border);
  --sidebar-ring: var(--ring);
}

.dark {
