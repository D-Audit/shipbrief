@layer base {
  * {
    @apply border-border outline-ring/50;
  }

  html {
    @apply font-sans scroll-smooth;
  }

  body {
    @apply bg-background text-foreground antialiased;
    font-feature-settings: "rlig" 1, "calt" 1;
  }

  h1,
  h2,
  h3,
  h4,
  h5,
  h6 {
    @apply font-semibold tracking-tight text-foreground;
  }

  :focus-visible {
    @apply outline-none ring-2 ring-ring ring-offset-2 ring-offset-background;
  }

  @media (prefers-reduced-motion: reduce) {
    *,
    *::before,
    *::after {
      animation-duration: 0.01ms !important;
      animation-iteration-count: 1 !important;
      transition-duration: 0.01ms !important;
      scroll-behavior: auto !important;
    }
  }
}

@layer utilities {
  .sb-animated-rainbow-ribbon {
    pointer-events: none;
    position: absolute;
    z-index: 0;
    top: -8rem;
    right: -11rem;
    width: min(105rem, 105vw);
    height: 58rem;
    overflow: hidden;
    opacity: var(--arr-opacity);
    filter: blur(var(--arr-blur));
    transform: translate3d(var(--arr-pointer-x, 0px), var(--arr-pointer-y, 0px), 0) scale(var(--arr-scale));
    transform-origin: top right;
    transition: transform 1.4s cubic-bezier(.2, .75, .25, 1);
    will-change: transform;
  }

  .sb-ribbon-layer,
  .sb-ribbon-glow {
    transform-box: fill-box;
    transform-origin: center;
    will-change: transform, opacity;
  }

  .sb-ribbon-glow { animation: sb-ribbon-glow calc(19s / var(--arr-speed)) ease-in-out infinite alternate; }
  .sb-ribbon-layer-back { animation: sb-ribbon-back calc(24s / var(--arr-speed)) cubic-bezier(.45, 0, .55, 1) infinite alternate; }
  .sb-ribbon-layer-main { animation: sb-ribbon-main calc(20s / var(--arr-speed)) cubic-bezier(.45, 0, .55, 1) infinite alternate; }
  .sb-ribbon-layer-front { animation: sb-ribbon-front calc(27s / var(--arr-speed)) cubic-bezier(.45, 0, .55, 1) infinite alternate; }

  @media (max-width: 1023px) {
    .sb-animated-rainbow-ribbon { top: 20rem; right: -26rem; width: 78rem; height: 47rem; opacity: calc(var(--arr-opacity) * .58); }
  }

  @media (max-width: 639px) {
    .sb-animated-rainbow-ribbon { top: 24rem; right: -31rem; width: 59rem; height: 34rem; opacity: calc(var(--arr-opacity) * .36); }
  }

  .sb-fluid-mesh {
    pointer-events: none;
    position: absolute;
    inset: -10% -5%;
    overflow: hidden;
    isolation: isolate;
  }

  .sb-fluid-field {
    position: absolute;
    width: 58%;
    aspect-ratio: 1;
    border-radius: 48% 52% 47% 53% / 52% 45% 55% 48%;
    filter: blur(22px);
    will-change: transform, border-radius;
  }

  .sb-fluid-field-one {
    top: -22%;
    left: -12%;
    background: rgb(249 207 221 / 0.58);
    animation: sb-fluid-one 24s ease-in-out infinite alternate;
  }

  .sb-fluid-field-two {
    right: -12%;
    bottom: -38%;
    background: rgb(239 160 182 / 0.32);
    animation: sb-fluid-two 29s ease-in-out infinite alternate;
  }

  .sb-fluid-field-three {
    top: 20%;
    left: 42%;
    width: 46%;
    background: rgb(235 224 218 / 0.72);
    animation: sb-fluid-three 32s ease-in-out infinite alternate;
  }

  .sb-fluid-mesh-subtle {
    opacity: 0.58;
  }

  .sb-page {
    @media (prefers-reduced-motion: no-preference) {
      animation: sb-page-enter 180ms ease-out both;
    }
  }

  .sb-panel {
    @apply rounded-[var(--radius-lg)] border border-border bg-card;
  }

  .sb-panel-raised {
    @apply rounded-[var(--radius-lg)] border border-border bg-card shadow-sm;
  }

  .sb-control {
    @apply rounded-[var(--radius-md)];
  }
}

@keyframes sb-fluid-one {
  0% { transform: translate3d(0, 0, 0) scale(1); border-radius: 48% 52% 47% 53% / 52% 45% 55% 48%; }
  46% { transform: translate3d(22%, 18%, 0) scale(1.12); border-radius: 55% 45% 56% 44% / 42% 55% 45% 58%; }
  100% { transform: translate3d(9%, 34%, 0) scale(0.94); border-radius: 43% 57% 42% 58% / 57% 41% 59% 43%; }
}

@keyframes sb-ribbon-glow {
  from { transform: translate3d(-2%, -3%, 0) scale(.96); opacity: .55; }
  to { transform: translate3d(4%, 5%, 0) scale(1.08); opacity: .9; }
}

@keyframes sb-ribbon-back {
  0% { transform: translate3d(-3%, -4%, 0) rotate(-3deg) scale(1.01, .96); }
  50% { transform: translate3d(4%, 4%, 0) rotate(3deg) scale(.97, 1.05); }
  100% { transform: translate3d(-1%, 8%, 0) rotate(-1deg) scale(1.04, .98); }
}

@keyframes sb-ribbon-main {
  0% { transform: translate3d(2%, -4%, 0) rotate(2deg) scale(1.04, .96); }
  52% { transform: translate3d(-5%, 3%, 0) rotate(-2.5deg) scale(.97, 1.06); }
  100% { transform: translate3d(3%, 9%, 0) rotate(1deg) scale(1.02, .99); }
}

@keyframes sb-ribbon-front {
  0% { transform: translate3d(-3%, 2%, 0) rotate(-2deg) scale(.98, 1.05); }
  48% { transform: translate3d(4%, -4%, 0) rotate(2deg) scale(1.05, .96); }
  100% { transform: translate3d(-1%, 7%, 0) rotate(-1deg) scale(.98, 1.04); }
}

@keyframes sb-fluid-two {
  0% { transform: translate3d(0, 0, 0) scale(0.92); border-radius: 52% 48% 55% 45% / 49% 57% 43% 51%; }
  52% { transform: translate3d(-25%, -22%, 0) scale(1.1); border-radius: 42% 58% 44% 56% / 58% 42% 56% 44%; }
  100% { transform: translate3d(-8%, -35%, 0) scale(1); border-radius: 57% 43% 52% 48% / 44% 56% 45% 55%; }
}

@keyframes sb-fluid-three {
  0% { transform: translate3d(0, 0, 0) scale(1); border-radius: 45% 55% 50% 50% / 54% 44% 56% 46%; }
  48% { transform: translate3d(-22%, 18%, 0) scale(1.14); border-radius: 57% 43% 58% 42% / 43% 57% 43% 57%; }
  100% { transform: translate3d(14%, -20%, 0) scale(0.9); border-radius: 49% 51% 42% 58% / 58% 46% 54% 42%; }
}

@media (prefers-reduced-motion: reduce) {
  .sb-fluid-field,
  .sb-ribbon-layer,
  .sb-ribbon-glow { animation: none; }

  .sb-animated-rainbow-ribbon { transition: none; }
}

@keyframes sb-page-enter {
  from {
    opacity: 0;
    transform: translateY(4px);
  }

  to {
    opacity: 1;
    transform: translateY(0);
  }
}
