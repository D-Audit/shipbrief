# ShipBrief API — copy to backend/.env and fill in. Never commit real values.
# Only DATABASE_URL and ENCRYPTION_KEY are required to run locally; every
# provider below is optional and the API reports clearly when one is missing.

# --- Core -------------------------------------------------------------------
NODE_ENV=development
PORT=4000
LOG_LEVEL=info
# Public URL of the web app. Used for email links, OAuth callbacks and CSRF origin checks.
APP_URL=http://localhost:3000
# Comma-separated extra origins allowed to make cookie-authenticated writes (optional).
TRUSTED_ORIGINS=
# Number of proxies in front of the API (Next.js rewrite = 1). Use 0 if the API is exposed directly.
TRUST_PROXY=1

# --- Database ---------------------------------------------------------------
# Local socket example: postgresql:///shipbrief?host=/var/run/postgresql
DATABASE_URL=postgresql://shipbrief:shipbrief@localhost:5432/shipbrief
DATABASE_POOL_MAX=10

# --- Security ---------------------------------------------------------------
# 32 random bytes, base64 or hex. Encrypts integration tokens and webhook secrets.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
ENCRYPTION_KEY=
SESSION_TTL_DAYS=30
REQUIRE_EMAIL_VERIFICATION=true
# Minutes between automatic checks of connected GitHub/GitLab/Linear/Jira for new work (0 = off).
INTEGRATION_SYNC_MINUTES=15

# --- Background worker ------------------------------------------------------
# embedded: the API process also runs the job worker (development).
# off: run `npm run start:worker` as a separate process (production).
WORKER_MODE=embedded

# ShipBrief's own "What's new" panel in the app's top bar: the widget key (Project ID,
# shown on Channels → In-app) of the workspace whose in-app releases your users should see.
# Leave empty to hide the button.
PRODUCT_UPDATES_WIDGET_KEY=
WORKER_CONCURRENCY=8

# --- AI (Anthropic Claude) --------------------------------------------------
# With a key, AI_PROVIDER defaults to "anthropic". Without one: "dev" (a
# deterministic, clearly labelled stand-in) in development, "none" in production.
AI_PROVIDER=
ANTHROPIC_API_KEY=
AI_MODEL=claude-opus-5-5
AI_TIMEOUT_MS=45000

# --- Email (Resend) ---------------------------------------------------------
# Verification, welcome, password reset, password-changed alerts, invitations,
# workspace notifications and release emails all go through Resend.
# Without a key, development uses the "log" provider: messages (including
# verification/reset links) are written to the API log and recorded as
# "logged", never "sent". Production needs RESEND_API_KEY, or the Gmail or SMTP settings below.
# EMAIL_FROM must use a domain you've verified in Resend (resend.com/domains) —
# never gmail.com or another free mailbox. Set EMAIL_PROVIDER=resend to use Resend
# even when Gmail/SMTP settings are present. Check with: npm run email:test -- you@example.com
EMAIL_PROVIDER=
RESEND_API_KEY=
# Or send from a Gmail account over the Gmail API (works on Render's free plan):
# an OAuth client and a refresh token for the gmail.send scope. Setting all four
# picks Gmail automatically. GMAIL_SENDER is the Gmail address that authorised it.
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=
GMAIL_SENDER=
# Or send from a Gmail account over SMTP: SMTP_USER is the Gmail address, SMTP_PASSWORD a
# 16-character App Password (myaccount.google.com/apppasswords). Setting both
# picks SMTP automatically. Render's free plan blocks SMTP ports.
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=ShipBrief <no-reply@example.com>

# --- File storage -----------------------------------------------------------
STORAGE_PROVIDER=local
STORAGE_LOCAL_DIR=./storage
# For STORAGE_PROVIDER=s3 (AWS S3 or compatible, e.g. R2/MinIO via S3_ENDPOINT):
S3_BUCKET=
S3_REGION=
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Public base URL for objects; leave empty to serve files through the API.
S3_PUBLIC_URL=

# --- Billing (Stripe) — plan changes are disabled until configured ------------
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_STARTER=
STRIPE_PRICE_PRO=
STRIPE_PRICE_SCALE=

# --- Sign in with Google (optional) -----------------------------------------
# console.cloud.google.com → APIs & Services → Credentials → OAuth client ID (Web application)
# Authorized redirect URI: {APP_URL}/api/auth/oauth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- GitHub: sign-in AND the GitHub source integration (optional) ------------
# github.com/settings/developers → OAuth Apps → New OAuth App
# Redirect URIs (GitHub matches exactly — add both, no wildcard, no device flow):
#   {APP_URL}/api/auth/oauth/github/callback
#   {APP_URL}/api/integrations/github/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# --- Other source integrations (optional) -----------------------------------
# Redirect URI to register with each provider: {APP_URL}/api/integrations/{provider}/callback
# GitLab: gitlab.com/-/user_settings/applications (scopes: read_api, read_user)
# Linear: linear.app/settings/api/applications/new
# Jira:   developer.atlassian.com/console/myapps → OAuth 2.0 (3LO); scopes read:jira-work read:me
GITLAB_CLIENT_ID=
GITLAB_CLIENT_SECRET=
GITLAB_BASE_URL=https://gitlab.com
LINEAR_CLIENT_ID=
LINEAR_CLIENT_SECRET=
JIRA_CLIENT_ID=
JIRA_CLIENT_SECRET=

# Allow webhook URLs on private networks (localhost testing only; refused in production).
WEBHOOK_ALLOW_PRIVATE_TARGETS=false
